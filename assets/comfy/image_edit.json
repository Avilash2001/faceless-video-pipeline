{
  "70": { "class_type": "UNETLoader", "inputs": { "unet_name": "flux-2-klein-4b.safetensors", "weight_dtype": "default" }, "_meta": { "title": "FLUX.2 klein 4B (distilled)" } },
  "71": { "class_type": "CLIPLoader", "inputs": { "clip_name": "qwen_3_4b.safetensors", "type": "flux2", "device": "default" } },
  "72": { "class_type": "VAELoader", "inputs": { "vae_name": "flux2-vae.safetensors" } },
  "81": { "class_type": "LoadImage", "inputs": { "image": "{{IMAGE_1}}" }, "_meta": { "title": "Character reference 1" } },
  "82": { "class_type": "LoadImage", "inputs": { "image": "{{IMAGE_2}}" }, "_meta": { "title": "Character reference 2 (repeats 1 when there is only one)" } },
  "83": { "class_type": "ImageScaleToTotalPixels", "inputs": { "image": ["81", 0], "upscale_method": "nearest-exact", "megapixels": 1, "resolution_steps": 1 } },
  "84": { "class_type": "ImageScaleToTotalPixels", "inputs": { "image": ["82", 0], "upscale_method": "nearest-exact", "megapixels": 1, "resolution_steps": 1 } },
  "85": { "class_type": "VAEEncode", "inputs": { "pixels": ["83", 0], "vae": ["72", 0] } },
  "86": { "class_type": "VAEEncode", "inputs": { "pixels": ["84", 0], "vae": ["72", 0] } },
  "74": { "class_type": "CLIPTextEncode", "inputs": { "text": "{{PROMPT}}", "clip": ["71", 0] }, "_meta": { "title": "Positive Prompt" } },
  "76": { "class_type": "ConditioningZeroOut", "inputs": { "conditioning": ["74", 0] } },
  "87": { "class_type": "ReferenceLatent", "inputs": { "conditioning": ["74", 0], "latent": ["85", 0] } },
  "88": { "class_type": "ReferenceLatent", "inputs": { "conditioning": ["87", 0], "latent": ["86", 0] } },
  "89": { "class_type": "ReferenceLatent", "inputs": { "conditioning": ["76", 0], "latent": ["85", 0] } },
  "90": { "class_type": "ReferenceLatent", "inputs": { "conditioning": ["89", 0], "latent": ["86", 0] } },
  "63": { "class_type": "CFGGuider", "inputs": { "model": ["70", 0], "positive": ["88", 0], "negative": ["90", 0], "cfg": 1 } },
  "61": { "class_type": "KSamplerSelect", "inputs": { "sampler_name": "euler" } },
  "62": { "class_type": "Flux2Scheduler", "inputs": { "steps": 4, "width": "{{WIDTH}}", "height": "{{HEIGHT}}" } },
  "66": { "class_type": "EmptyFlux2LatentImage", "inputs": { "width": "{{WIDTH}}", "height": "{{HEIGHT}}", "batch_size": 1 } },
  "73": { "class_type": "RandomNoise", "inputs": { "noise_seed": "{{SEED}}" } },
  "64": { "class_type": "SamplerCustomAdvanced", "inputs": { "noise": ["73", 0], "guider": ["63", 0], "sampler": ["61", 0], "sigmas": ["62", 0], "latent_image": ["66", 0] } },
  "65": { "class_type": "VAEDecode", "inputs": { "samples": ["64", 0], "vae": ["72", 0] } },
  "9": { "class_type": "SaveImage", "inputs": { "images": ["65", 0], "filename_prefix": "pipeline" } }
}
