# ==========================================================
# 1. STORY BRAIN (Gemini text models work on the free tier)
# ==========================================================
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ==========================================================
# 2. STORY SOURCES
# ==========================================================
# Reddit access mode for the reddit_* genres:
#   inbox = stories you have permission to adapt, dropped into data/story_inbox/ (default)
#   api   = official Data API; needs an approved app (Reddit requires pre-approval, and
#           monetized use needs a commercial agreement with Reddit)
#   rss   = public top-of-week feeds; full text but ~1 request/minute, and Reddit's terms
#           prohibit automated scraping without consent. Opt-in at your own risk.
REDDIT_ACCESS=inbox
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Reddit requires <platform>:<app id>:<version> (by /u/<username>)
REDDIT_USER_AGENT=node:faceless-video-pipeline:v2.0.0 (by /u/your_username)

# ==========================================================
# 3. SCENE VISUALS (pick per run with --images / --motion)
# ==========================================================
# gemini  = Nano Banana on GEMINI_API_KEY (~$0.05/image at 2K; needs billing enabled, free tier is 0)
# comfyui = local ComfyUI server (free; e.g. FLUX.2 klein 4B on an RTX 3060)
# fal     = fal.ai (Seedream 5 Lite ~$0.035/image; needs FAL_KEY)
# stock   = Pixabay/Pexels clips (free, generic)
IMAGE_PROVIDER=gemini
IMAGE_FALLBACK=stock
IMAGE_CONCURRENCY=3

# AI motion clips for the hook and climax scenes (other scenes use pan/zoom):
# none | gemini (Omni Flash, ~$0.10/s, billing required) | fal (Kling, ~$0.21 per 5s) | comfyui (Wan 2.2, free)
MOTION_PROVIDER=none
MOTION_CLIPS_PER_VIDEO=2

GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
GEMINI_IMAGE_SIZE=2K
GEMINI_VIDEO_MODEL=gemini-omni-1.1-flash

COMFYUI_URL=http://127.0.0.1:8188
# API-format workflow exports in assets/comfy/ (see assets/comfy/README.md)
COMFYUI_IMAGE_WORKFLOW=image_t2i.json
COMFYUI_IMAGE_EDIT_WORKFLOW=image_edit.json
COMFYUI_VIDEO_WORKFLOW=video_i2v.json
COMFYUI_IMAGE_WIDTH=896
COMFYUI_IMAGE_HEIGHT=1600
COMFYUI_VIDEO_WIDTH=480
COMFYUI_VIDEO_HEIGHT=832
COMFYUI_VIDEO_FPS=16

FAL_KEY=
FAL_IMAGE_MODEL=fal-ai/bytedance/seedream/v5/lite/text-to-image
FAL_IMAGE_EDIT_MODEL=fal-ai/bytedance/seedream/v5/lite/edit
FAL_VIDEO_MODEL=fal-ai/kling-video/v2.5-turbo/standard/image-to-video

# Optional stock fallback: free key from https://pixabay.com/api/docs/
PIXABAY_API_KEY=
# Optional: Pexels API key (currently paused by Pexels for new signups)
PEXELS_API_KEY=

# ==========================================================
# 4. AUDIO & RENDERING
# ==========================================================
# Background music: put tracks in assets/music/<mood>/ (tense, mysterious, upbeat,
# emotional, dark, playful) or directly in assets/music/. Ducked under the voice.
MUSIC_DIR=
MUSIC_VOLUME=0.18

# ffmpeg with libass (needed for subtitle burn-in). Homebrew's `ffmpeg-full` is keg-only,
# so point at it explicitly. On Windows use a "full" build (gyan.dev) and its ffmpeg.exe path.
# Leave empty to use whatever `ffmpeg` is on PATH.
FFMPEG_PATH=/opt/homebrew/opt/ffmpeg-full/bin/ffmpeg

# ==========================================================
# 5. YOUTUBE SHORTS (Google Cloud Console OAuth2)
# ==========================================================
YOUTUBE_CLIENT_ID=your_google_client_id
YOUTUBE_CLIENT_SECRET=your_google_client_secret
YOUTUBE_REFRESH_TOKEN=your_oauth2_refresh_token
# public | unlisted | private
YOUTUBE_PRIVACY=public

# ==========================================================
# 6. INSTAGRAM REELS & FACEBOOK REELS (Meta Graph API v21.0)
# ==========================================================
# Long-lived Page/System User Access Token with:
# instagram_basic, instagram_content_publish, instagram_manage_insights,
# pages_read_engagement, pages_manage_posts, read_insights
META_ACCESS_TOKEN=your_meta_long_lived_token
INSTAGRAM_BUSINESS_ACCOUNT_ID=your_ig_business_id
FACEBOOK_PAGE_ID=your_fb_page_id

# Optional: Public URL prefix where rendered MP4s are temporarily reachable by IG Graph API
# (e.g. Cloudflare R2 public bucket, AWS S3 presigned URL, or VPS static nginx folder)
PUBLIC_VIDEO_BASE_URL=https://media.yourdomain.com/reels

# ==========================================================
# 7. PIPELINE SCHEDULE & TUNING
# ==========================================================
CRON_GENERATE_SCHEDULE=0 8,18 * * *
CRON_METRICS_SCHEDULE=0 2 * * *
CRON_EVOLVE_SCHEDULE=0 4 * * 0
# Keep false while testing; true publishes every generated video.
ENABLE_AUTO_UPLOAD=false
