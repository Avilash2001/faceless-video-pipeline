# ==========================================================
# 1. CORE AI & VISUAL ASSETS (Near-Zero Cost)
# ==========================================================
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Optional: Free API key from https://pixabay.com/api/docs/ (instant, no waitlist)
PIXABAY_API_KEY=
# Optional: Pexels API key (currently paused by Pexels for new signups)
PEXELS_API_KEY=

# ==========================================================
# 2. YOUTUBE SHORTS (Google Cloud Console OAuth2)
# ==========================================================
YOUTUBE_CLIENT_ID=your_google_client_id
YOUTUBE_CLIENT_SECRET=your_google_client_secret
YOUTUBE_REFRESH_TOKEN=your_oauth2_refresh_token

# ==========================================================
# 3. INSTAGRAM REELS & FACEBOOK REELS (Meta Graph API v21.0)
# ==========================================================
# Long-lived Page/System User Access Token with:
# instagram_basic, instagram_content_publish, instagram_manage_insights,
# pages_read_engagement, pages_manage_posts, read_insights
META_ACCESS_TOKEN=your_meta_long_lived_token
INSTAGRAM_BUSINESS_ACCOUNT_ID=your_ig_business_id
FACEBOOK_PAGE_ID=your_fb_page_id

# Optional: Public URL prefix where rendered MP4s are temporarily reachable by IG Graph API
# (e.g. Cloudflare R2 public bucket, AWS S3 presigned URL, or VPS static nginx folder)
PUBLIC_VIDEO_BASE_URL=https://media.yourdomain.com/reels

# ==========================================================
# 4. PIPELINE SCHEDULE & TUNING
# ==========================================================
CRON_GENERATE_SCHEDULE=0 8,18 * * *
CRON_METRICS_SCHEDULE=0 2 * * *
CRON_EVOLVE_SCHEDULE=0 4 * * 0
ENABLE_AUTO_UPLOAD=true
