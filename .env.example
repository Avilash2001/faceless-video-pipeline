# ==========================================================
# 1. STORY BRAIN (Gemini)
# ==========================================================
GEMINI_API_KEY=your_gemini_api_key_here
# Writes the storyboard (creative step). gemini-2.0/2.5-flash are no longer served.
GEMINI_MODEL=gemini-3.8-flash
# Picks and briefs the story; the cheapest model is plenty ($0.25/$1.50 per 1M tokens)
GEMINI_EDITOR_MODEL=gemini-3.1-flash-lite
# minimal | low | medium | high. Thinking tokens are billed as output tokens.
GEMINI_THINKING=low

# ==========================================================
# 1b. COST CONTROL
# ==========================================================
# Hard cap on paid API spend per UTC day (images, motion clips, music, text). When paid
# images would exceed it, the run switches to comfyui (if IMAGE_FALLBACK=comfyui) or skips the video.
DAILY_BUDGET_USD=0.50
# Display only: logs show USD plus INR including GST.
USD_TO_INR=88
COST_TAX_MULTIPLIER=1.18

# ==========================================================
# 2. STORY SOURCES
# ==========================================================
# Reddit access mode for the reddit_* genres:
#   inbox = stories you have permission to adapt, dropped into data/story_inbox/ (default)
#   api   = official Data API; needs an approved app (Reddit requires pre-approval, and
#           monetized use needs a commercial agreement with Reddit)
#   rss   = public top-of-week feeds; full text but ~1 request/minute, and Reddit's terms
#           prohibit automated scraping without consent. Opt-in at your own risk.
REDDIT_ACCESS=inbox
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Reddit requires <platform>:<app id>:<version> (by /u/<username>)
REDDIT_USER_AGENT=node:faceless-video-pipeline:v2.0.0 (by /u/your_username)

# ==========================================================
# 3. SCENE VISUALS (pick per run with --images / --motion)
# ==========================================================
# gemini  = Nano Banana on GEMINI_API_KEY ($0.034/image at 1K; needs billing, free tier is 0)
# comfyui = local ComfyUI server (free; e.g. FLUX.2 klein 4B on an RTX 3060)
# fal     = fal.ai (Seedream 5 Lite ~$0.035/image; needs FAL_KEY)
# stock   = Pixabay/Pexels clips (free, generic)
IMAGE_PROVIDER=gemini
# Per-scene fallback when a scene fails twice: none = reuse a neighbouring scene's image
# (keeps one art style; recommended) | comfyui | fal | stock. Over the daily budget, only
# comfyui is used as a substitute; otherwise the video is skipped.
IMAGE_FALLBACK=none
IMAGE_CONCURRENCY=3

# AI motion clips (other scenes use free pan/zoom). 1 = hook only, 2 = hook + climax.
# none | gemini (Omni Flash, ~$0.10/s, ~$0.40 per clip) | fal (Kling, ~$0.21 per 5s) | comfyui (Wan 2.2, free)
MOTION_PROVIDER=none
MOTION_CLIPS_PER_VIDEO=1

GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
# 1K ($0.034) is upscaled for pan/zoom; 2K ($0.050) is sharper
GEMINI_IMAGE_SIZE=1K
GEMINI_VIDEO_MODEL=gemini-omni-1.1-flash
# Used once by `npm run make-music` to build the music library ($0.08 per track)
GEMINI_MUSIC_MODEL=lyria-3.5

COMFYUI_URL=http://127.0.0.1:8188
# API-format workflow exports in assets/comfy/ (see assets/comfy/README.md)
COMFYUI_IMAGE_WORKFLOW=image_t2i.json
COMFYUI_IMAGE_EDIT_WORKFLOW=image_edit.json
COMFYUI_VIDEO_WORKFLOW=video_i2v.json
COMFYUI_IMAGE_WIDTH=896
COMFYUI_IMAGE_HEIGHT=1600
COMFYUI_VIDEO_WIDTH=480
COMFYUI_VIDEO_HEIGHT=832
COMFYUI_VIDEO_FPS=16
COMFYUI_TIMEOUT_MS=1200000

FAL_KEY=
FAL_IMAGE_MODEL=fal-ai/bytedance/seedream/v5/lite/text-to-image
FAL_IMAGE_EDIT_MODEL=fal-ai/bytedance/seedream/v5/lite/edit
FAL_VIDEO_MODEL=fal-ai/kling-video/v2.5-turbo/standard/image-to-video
# Used for the cost log and daily budget
FAL_IMAGE_COST_USD=0.035
FAL_VIDEO_COST_PER_SECOND_USD=0.042

# Optional stock fallback: free key from https://pixabay.com/api/docs/
PIXABAY_API_KEY=
# Optional: Pexels API key (currently paused by Pexels for new signups)
PEXELS_API_KEY=

# ==========================================================
# 4. AUDIO & RENDERING
# ==========================================================
# Background music: `npm run make-music` builds assets/music/<mood>/ once with Lyria (~$0.48
# for all six moods); you can also drop your own royalty-free tracks there. Ducked under the voice.
# SFX: `npm run make-sfx` synthesizes assets/sfx/{whoosh,impact,riser}.wav (free).
# Leave MUSIC_DIR empty to use assets/music.
MUSIC_DIR=
MUSIC_VOLUME=0.18

# ffmpeg with libass (needed for subtitle burn-in). Homebrew's `ffmpeg-full` is keg-only,
# so point at it explicitly. On Windows use a "full" build (gyan.dev) and its ffmpeg.exe path.
# Leave empty to use whatever `ffmpeg` is on PATH.
FFMPEG_PATH=/opt/homebrew/opt/ffmpeg-full/bin/ffmpeg

# ==========================================================
# 5. YOUTUBE SHORTS (Google Cloud Console OAuth2)
# ==========================================================
YOUTUBE_CLIENT_ID=your_google_client_id
YOUTUBE_CLIENT_SECRET=your_google_client_secret
YOUTUBE_REFRESH_TOKEN=your_oauth2_refresh_token
# public | unlisted | private
YOUTUBE_PRIVACY=public

# ==========================================================
# 6. INSTAGRAM REELS & FACEBOOK REELS (Meta Graph API v21.0)
# ==========================================================
# Long-lived Page/System User Access Token with:
# instagram_basic, instagram_content_publish, instagram_manage_comments, instagram_manage_insights,
# pages_show_list, pages_read_engagement, pages_manage_posts, read_insights
# (see docs/CHANNEL_SETUP.md). Instagram videos are uploaded directly; no public URL needed.
META_ACCESS_TOKEN=your_meta_long_lived_token
INSTAGRAM_BUSINESS_ACCOUNT_ID=your_ig_business_id
FACEBOOK_PAGE_ID=your_fb_page_id
# Graph API version for Instagram + Facebook calls (v21.0 expires Jan 2027)
META_GRAPH_VERSION=v26.0

# ==========================================================
# 7. PIPELINE SCHEDULE & TUNING
# ==========================================================
# One video a day at 18:00 machine time (cron syntax). Add hours, e.g. "0 8,18 * * *", for more.
CRON_GENERATE_SCHEDULE=0 18 * * *
CRON_METRICS_SCHEDULE=0 2 * * *
CRON_EVOLVE_SCHEDULE=0 4 * * 0
# Keep false while testing; true publishes every generated video.
ENABLE_AUTO_UPLOAD=false

# ==========================================================
# 8. DASHBOARD (served by `npm run daemon`)
# ==========================================================
# The dashboard listens on 127.0.0.1 only, at this port, and has no login.
DASHBOARD_PORT=4747
# Host names the dashboard answers to (comma-separated); requests for any other name are refused.
# To reach it from your other devices, put it on your Tailscale network (e.g. `tailscale serve`)
# and add the machine's Tailscale name here, e.g. localhost,127.0.0.1,my-pc.tail1234.ts.net
DASHBOARD_ALLOWED_HOSTS=localhost,127.0.0.1
